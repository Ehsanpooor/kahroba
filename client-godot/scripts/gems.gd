class_name Gems
extends RefCounted
## The five gems + gold: their colours, and where their art lives.
## Art made for the Splendor board goes in res://assets/splendor/ (prepared
## from art/generated by tools/prepare_splendor.py). Every piece draws a
## procedural look until its picture exists, so the board always works.

const COLORS := ["white", "blue", "green", "red", "black"]
const ALL := ["white", "blue", "green", "red", "black", "gold"]

## Main colour of each gem (enamel, card tint, pips).
const BASE := {
	"white": Color(0.93, 0.93, 0.95), "blue": Color(0.12, 0.35, 0.85), "green": Color(0.1, 0.62, 0.3),
	"red": Color(0.82, 0.1, 0.12), "black": Color(0.16, 0.13, 0.14), "gold": Color(0.95, 0.72, 0.2),
}
## Light glints and particle colour.
const GLOW := {
	"white": Color(1.0, 0.97, 0.9), "blue": Color(0.35, 0.65, 1.0), "green": Color(0.4, 1.0, 0.5),
	"red": Color(1.0, 0.35, 0.3), "black": Color(0.7, 0.55, 0.85), "gold": Color(1.0, 0.82, 0.35),
}
## Text that sits on the colour.
const INK := {
	"white": Color(0.08, 0.08, 0.1), "blue": Color(1, 1, 1), "green": Color(1, 1, 1),
	"red": Color(1, 1, 1), "black": Color(1, 1, 1), "gold": Color(0.2, 0.12, 0.02),
}
## Levels I / II / III: green, amber, royal blue (card backs, frames).
const TIER := {1: Color(0.16, 0.4, 0.2), 2: Color(0.72, 0.5, 0.12), 3: Color(0.16, 0.3, 0.68)}
const ROMAN := {1: "I", 2: "II", 3: "III"}

const ROOT := "res://assets/splendor/"


static func path_if(rel: String) -> String:
	var p := ROOT + rel
	return p if ResourceLoader.exists(p) else ""


## The token face with its gem (the 3D chips on the table).
static func token_tex(col: String) -> Texture2D:
	var p := path_if("hud/tok_%s.png" % col)
	return Tex.get_tex(p) if p != "" else null


static func gem_tex(col: String) -> Texture2D:
	var p := path_if("gems/%s.png" % col)
	return Tex.get_tex(p) if p != "" else null


static func card_art(col: String, tier: int, variant := 0) -> Texture2D:
	var p := path_if("cards/%s_%d_%d.png" % [col, tier, variant]) if variant > 0 else ""
	if p == "":
		p = path_if("cards/%s_%d.png" % [col, tier])
	return Tex.get_tex(p) if p != "" else null


static func frame_tex(col: String) -> Texture2D:
	var p := path_if("frames/card_%s.png" % col)
	return Tex.get_tex(p) if p != "" else null


## The cost circle on the cards (the painted medallion).
static func pip_tex(col: String) -> Texture2D:
	var p := path_if("pips/%s.png" % col)
	return Tex.get_tex(p) if p != "" else null


## The plain token with room for a number (the players' token counts).
static func num_tex(col: String) -> Texture2D:
	var p := path_if("hud/num_%s.png" % col)
	return Tex.get_tex(p) if p != "" else null


static func back_tex(tier: int) -> Texture2D:
	var p := path_if("card_backs/tier%d.png" % tier)
	return Tex.get_tex(p) if p != "" else null


static func noble_tex(id: String) -> Texture2D:
	var p := path_if("nobles/%s.png" % id)
	return Tex.get_tex(p) if p != "" else null


static func table_tex() -> Texture2D:
	var p := path_if("table/board_bg.png")
	if p == "":
		p = path_if("table/board_bg.jpg")
	return Tex.get_tex(p) if p != "" else null


## A flat gem icon (a quad lying on the table, `d` local units wide): the
## painted gem when it exists, else a cut gem drawn by the shader.
static func icon(col: String, d: float, offset := Vector2.ZERO) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.mesh = Meshes.quad(d, d, offset)
	var m := ShaderMaterial.new()
	m.shader = preload("res://shaders/gem_icon.gdshader")
	var t := gem_tex(col)
	m.set_shader_parameter("has_tex", 1.0 if t else 0.0)
	if t:
		m.set_shader_parameter("tex", t)
	m.set_shader_parameter("col", BASE[col])
	m.set_shader_parameter("glint", GLOW[col])
	mi.material_override = m
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return mi


## A round cost medallion with its number (cards, nobles): the painted
## medallion when it exists, else a glossy drawn one.
static func pip(col: String, n: int, d: float, pos: Vector2) -> Node3D:
	var root := Node3D.new()
	var mi := MeshInstance3D.new()
	mi.mesh = Meshes.quad(d, d, pos)
	var m := ShaderMaterial.new()
	var t := pip_tex(col)
	if t:
		m.shader = preload("res://shaders/art.gdshader")
		m.set_shader_parameter("tex", t)
		m.set_shader_parameter("lit", 0.25)
	else:
		m.shader = preload("res://shaders/pip.gdshader")
		m.set_shader_parameter("col", BASE[col])
	mi.material_override = m
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	root.add_child(mi)
	var l := Fonts.label3d(str(n), d * 0.72, INK[col], "num", 3.0 if col == "white" else 6.0,
			Color(1, 1, 1, 0.6) if col == "white" else Color(0, 0, 0, 0.85))
	l.position = Vector3(pos.x, 0.6, pos.y + d * 0.02)
	root.add_child(l)
	return root
