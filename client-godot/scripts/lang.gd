static func fa() -> bool:
	return code == "fa"


## The text for `key` in the current language; {0}, {1} are filled with a, b.
static func t(key: String, a: Variant = null, b: Variant = null) -> String:
	var pair: Array = S.get(key, [key, key])
	var s: String = pair[0] if code == "fa" else pair[1]
	if a != null:
		s = s.replace("{0}", str(a))
	if b != null:
		s = s.replace("{1}", str(b))
	return s


static func gem(col: String) -> String:
	return t("gem_" + col)
