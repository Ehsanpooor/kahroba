; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Splendor"
config/name_localized={
"fa": "اسپلندور"
}
config/version="0.9.3"
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0431373, 0.0431373, 0.0392157, 1)
boot_splash/show_image=false
config/icon="res://assets/icon/icon.png"
config/windows_native_icon="res://assets/icon/splendor.ico"

[autoload]

Prefs="*res://scripts/prefs.gd"
Perf="*res://scripts/perf.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"
Api="*res://scripts/server_api.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1200
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_lights_per_object=4
limits/opengl/max_renderable_lights=16
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)

[shader_globals]

pointer_world={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
light_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
px_unit={
"type": "float",
"value": 0.0115
}
flicker={
"type": "float",
"value": 0.0
}

[importer_defaults]

texture={
"compress/mode": 1,
"compress/lossy_quality": 0.88,
"detect_3d/compress_to": 0
}
