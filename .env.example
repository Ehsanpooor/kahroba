# Copy to .env and change every value before this stack is reachable from any
# network. The defaults compiled into docker-compose.yml are Nakama's published
# ones: anyone can authenticate against a server still using them.

# Postgres. Change before first boot; changing it later means recreating the volume.
POSTGRES_PASSWORD=change-me-postgres

# The client's server key. Every app build must ship the same value, so treat a
# change as an app release, not a config tweak.
NAKAMA_SERVER_KEY=change-me-server-key

# Session signing. Rotating either of these invalidates all live sessions.
NAKAMA_SESSION_KEY=change-me-session-encryption-key
NAKAMA_REFRESH_KEY=change-me-refresh-encryption-key

# Admin console. Bound to localhost in compose; reach it over an SSH tunnel.
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me-console-password

NAKAMA_LOG_LEVEL=INFO

# AI search budgets in milliseconds, per move, on one core. Lower them if the
# host is CPU-bound; the bot gets weaker but never illegal.
AI_HARD_THINK_MS=320
AI_NORMAL_THINK_MS=45
