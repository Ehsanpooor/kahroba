# Splendor server secrets (created by deploy.sh on the first deploy).
POSTGRES_PASSWORD=@POSTGRES@
# Must equal SERVER_KEY in client-godot/scripts/server_api.gd (every app build).
NAKAMA_SERVER_KEY=splendor-tester-2026
NAKAMA_SESSION_KEY=@SESSION@
NAKAMA_REFRESH_KEY=@REFRESH@
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=@CONSOLE@
NAKAMA_LOG_LEVEL=INFO
# Server-to-server key for the runtime RPCs: nginx adds it to the admin
# page's calls (/admin/api/...), so it never reaches a browser.
NAKAMA_HTTP_KEY=@HTTPKEY@
# The admin page (https://splendor.aizood.ir/admin/), user "admin".
ADMIN_PASSWORD=@ADMINPW@
# The public port players connect to (open it in the VPS firewall).
SPLENDOR_PORT=7450
AI_HARD_THINK_MS=320
AI_NORMAL_THINK_MS=45
AI_VERYHARD_THINK_MS=1200
# The mail account that sends recovery codes. Zoho Mail: smtp.zoho.com
# (smtppro.zoho.com for a domain mailbox), port 465, your address and an
# app password. ZeptoMail: smtp.zeptomail.com, user emailapikey, the token.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=اسپلندور
# Mailerino: SMTP_HEADERS=IsTransactional: True and SMTP_UNSUBSCRIBE={unsubscribe}
SMTP_HEADERS=
SMTP_UNSUBSCRIBE=
